{
  "name": "chuangdex",
  "version": "0.1.0",
  "private": true,
  "description": "ChuangDex desktop client - our own Agent product",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test:memory": "esbuild scripts/memory-smoke.ts --bundle --packages=external --platform=node --format=esm --outfile=.tmp/memory-smoke.mjs && node .tmp/memory-smoke.mjs",
    "test:mcp": "esbuild scripts/mcp-smoke.ts --bundle --packages=external --platform=node --format=esm --outfile=.tmp/mcp-smoke.mjs && node .tmp/mcp-smoke.mjs",
    "test:review": "esbuild scripts/review-regressions.ts --bundle --packages=external --platform=node --format=esm --outfile=.tmp/review-regressions.mjs && node .tmp/review-regressions.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/tar-stream": "^3.1.4",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^8.0.7",
    "remark-gfm": "^3.0.1",
    "tar-stream": "^3.2.0",
    "yaml": "^2.9.0"
  },
  "allowScripts": {}
}
